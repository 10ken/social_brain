rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cross-device content sync is deliberately disabled while encryption keys
    // are device-only. Cloud Functions use the Admin SDK and are unaffected by
    // these client rules.
    match /users/{userId} {
      allow read, write: if false;

      match /records/{recordId} {
        allow read, write: if false;
      }
    }

    // Callable-function quota metadata is private to the Admin SDK.
    match /internalAiRateLimits/{userId} {
      allow read, write: if false;
    }
  }
}
